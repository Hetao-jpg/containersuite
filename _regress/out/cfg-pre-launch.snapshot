[CustomInfrastructure]
# 开启=蛙哥升满级（wb_stage 达上限）后的妙妙箱主权归本 mod。关闭=交还蛙哥。关闭无害——妙妙箱两边材料不重叠（蛙哥用坚果金属、本 mod 用金属锭），不存在抢材料。未满级时本项本来就不生效。
3B_SkipWageBox = true
# 默认开启=虚空珠归蛙哥，保留原版「拖垃圾 +1 格」逐格解锁到 200 格。一旦你按住升级键（默认 LeftAlt）拖材料到虚空珠上，就等于说「这个我要用 DIY 升」，会**永久**移交本 mod（之后蛙哥的逐格解锁对该颗珠子永久失效，无法手动换回）。只有在你不想让出主权时才关闭本项——关闭后虚空珠无条件归本 mod，蛙哥的逐格解锁立刻完全失效（这是 S8j 的旧行为）。
3C_SkipVoidBead = true
# 所有槽共享的最大行数
5A_ModContainerMaxH = 20
# 读档后自动把已升级的容器恢复成升级后的尺寸。若读档崩溃（CLR 0x80131506）请关掉本项。
23_RestoreOnLoad = true
# 开启=6 个货舱的尺寸主权归本 mod，XIAOWO 无法升级它们。关闭=主权交还 XIAOWO，本 mod 也不再改这些货舱的尺寸（两边会各写各的，可能互相覆盖）。仅在排查冲突时关闭。虚空珠不受本项影响。
3A_SkipXiaoBay = true
# 所有槽共享的最大列数
5A_ModContainerMaxW = 20
# 是否允许通过拖拽窗口边缘调整容器大小。默认开启。
