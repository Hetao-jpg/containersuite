# 主仓库的总页数，范围 1-10。每页 24x10 = 240 格。
8A_SaveBagPageCount = 2
# TAB 切页成功后，屏幕提示显示多少秒。默认 1.0，范围 0.1 ~ 5.0。0 = 不显示。
8B_SaveBagPagingHintDuration = 1.0
# true = 强制把所有网格填充底画成不透明（黑色格子）。默认 false。
z2_ShowGrid = false
# true = 应用下方所有容器的自定义尺寸；false = 所有容器按游戏原版尺寸。
7_ExpandEnabled = true
# （默认值 = 当前游戏原版尺寸；[扩容] 启用为 true 时才会应用）
7D_SaveBagWidth = 24
# （默认值 = 当前游戏原版尺寸；[扩容] 启用为 true 时才会应用）
7D_SaveBagHeight = 20
# （默认值 = 当前游戏原版尺寸；[扩容] 启用为 true 时才会应用）
7E_ShowcaseInvWidth = 9
# （默认值 = 当前游戏原版尺寸；[扩容] 启用为 true 时才会应用）
7E_ShowcaseInvHeight = 7
# （默认值 4x4；游戏原版 2x2）
7C_HiddenInvWidth = 4
# （默认值 4x4；游戏原版 2x2）
7C_HiddenInvHeight = 4
# （默认值 = 当前游戏原版尺寸；[扩容] 启用为 true 时才会应用）
7A_BackInvWidth = 18
# （默认值 = 当前游戏原版尺寸；[扩容] 启用为 true 时才会应用）
7A_BackInvHeight = 4
# （默认值 = 当前游戏原版尺寸；[扩容] 启用为 true 时才会应用）
7B_FrontInvWidth = 18
# （默认值 = 当前游戏原版尺寸；[扩容] 启用为 true 时才会应用）
7B_FrontInvHeight = 4

[SuthPerk]
# 输出天赋注册、贴图加载与结算命中的详细日志。
DebugLogging = false

["DIY捕鼠夹"]
Enable = true
AutoCatchIntervalDays = 1
AutoCatchChance = 0.10000000149011612
ExtraLootCount = 2
ExtraLootChance = 0.10000000149011612

[RealPrinter]
FeatureCost = 20
VerboseLog = false
SupplierStock = true
EnableF6Give = false

[SecretAdmirerTweaks]
TriggerChance = 0.5
TriggerCooldown = 5.0
EnablePity = true
GuaranteeT1 = true
EnableDebugLog = false
# 自动保存字段
T3PlusPityCount = 4
# 自动保存字段
T4PlusPityCount = 4

["diy aug"]
# 是否启用此 mod。false 时完全恢复原版行为。
Enabled = true
# 每日额外刷新 Aug 的概率（0-100）。100 表示每天必定多刷一个 Aug。
ExtraVisitChance = 10
# 每天最多生成的 Aug 数量。原版为 2。
DailyAugLimit = 2
# 未击杀的 Aug 在睡觉时是否触发游戏结束。true = 结束游戏（原版）；false = 不结束，仅记录。
EnableRetaliation = false
# 是否钳制存在感数值，防止被游戏机制清零或溢出。
EnablePresenceGuard = true
# Aug 已引入且未结束时，存在感的最低值。0 表示不保护下限。
MinimumPresence = 1
# 困难模式下的存在感最高值。原版为 99。
HardModeMaxPresence = 99
# 放走 Aug 时存在感增加量的倍率。1.0 = 原版（+10/+15）。
PresenceGainMultiplier = 1.0
# 击杀 Aug 时存在感减少量的倍率。1.0 = 原版（-25/-10）。
PresenceLossMultiplier = 1.0
# 是否显示 Aug 实时监控面板。
AugPanelVisible = false
# 开关监控面板的按键。
AugPanelKey = "F4"
# 面板左上角 X 坐标（拖动后自动保存）。
AugPanelX = 380.0
# 面板左上角 Y 坐标（拖动后自动保存）。
AugPanelY = 20.0
# 面板宽度（拖动右下角可调整）。
AugPanelWidth = 280.0
# 面板高度（拖动右下角可调整）。
AugPanelHeight = 420.0

[CustomRatPrinter]
# 打印一次的基准价值（未升级时）
PrintCost = 1000
# 升级折扣公式的价值基准（原版瓶装机 800）
BaseMachineValue = 800
# 升级能带来的最大打印折扣百分比（0-100）
MaxDiscountPercent = 50
# 原版瓶装机为 9（1-99）
MaxUpgradeLevel = 9
# 仅供旧档估算升级等级时使用（显示用）
StandardElectronicValue = 33
# true = 游戏内按 F7 直接领取一台打印机
EnableF7Debug = false

[ItemStacking]
# 单个槽位允许的最大堆叠数量。
NewStackCap = 10
# 读档时，把原本恰好叠满旧上限的存量物品补满到新上限。
FillToCapOnLoad = true
# 打本 mod 之前游戏的默认堆叠上限，用于识别『之前已叠满』的物品。
OldStackCap = 10
# 把一个物品拖到同名物品上即合并堆叠（0.2.0 核心功能）。
EnableStacking = true
# 按住 Ctrl 开始拖动 = 拿起整堆；不按 = 只拿 1 个。原生 Shift（10%）/ Alt（1 个）/ 拖起后滚轮微调数量不受影响。
CtrlDragWholeStack = true
# 开启后输出堆叠/合并决策的详细诊断日志到控制台，用于排查堆叠异常。默认关闭；开启仅在调试时有用，正常游戏请保持关闭避免刷屏。
DiagLog = false
# 0.5.0 起：阻止「有独立状态」的物品被堆叠，避免丢失鉴定/所有权等属性。关闭后黑名单完全失效（恢复到 0.4.1 之前的放任行为，不推荐）。
StackBlacklist = true
# 拦截 INSPECTABLE_TAG / APPRAISAL_ITEM 物品的堆叠（等离子、仿生机械手、肋排三明治等）。这些物品鉴定后每个有独立的鉴定结果（真伪/价值/纯度），堆叠合并会丢失、拖出来变默认。
BlockInspectable = true
# 拦截 STOLEN_TAG 物品的堆叠。偷来的物品带独立热度值，合并会污染所有权与警察检查判定。
BlockStolen = true
# 拦截「已拥有 / 未拥有」状态不同的两件物品堆叠。商人出售的未付款物品若被堆进已拥有堆，除第一个外会变成『已拥有』从而免费拿走 —— 此开关堵住该盗窃漏洞。
BlockOwnershipMismatch = true
# 拦截「未拥有」（无 IS_OWNED_TAG）物品参与堆叠。商人商品池/柜台上的未付款商品、场景里还没捡起的物品都算未拥有 —— 它们堆叠会导致『除第一个外免费用』的盗窃漏洞，或商人商品之间被合并。只放行『两件都已拥有』的堆叠。
BlockUnowned = true
# 拦截电量（power_source_item_energy tag）不同的两块电池堆叠。电量不同的电池合并后，除第一个外会丢失各自的剩余电量，变成与第一个相同。
BlockChargeMismatch = true
# 逗号分隔的容器 id（如 back_inv_save_bag）。语义随 StrictWhitelist 变化：① StrictWhitelist = false（默认）：留空 = 不限范围（全放行）；填了 id 则只有被堆叠到的物品所在容器 id 在白名单内才允许堆叠。② StrictWhitelist = true：只有白名单内才允许堆叠，留空 = 任何容器都不堆叠（严格模式）。
StackScope = ""
# 拦截 ANIMAL_ITEM_TAG 物品的堆叠（鼠 / 鸡 / 牛等活体动物）。每个动物个体都有独立的年龄、体重、健康、饥饿、性别、怀孕进度与基因数据，合并会全部丢失。
BlockAnimal = true
# 拦截物种为 ANIMAL_RAT 的物品（读 ANIMAL_SPECIES_TAG 的字符串值比对）。注意 ANIMAL_RAT 是物种值不是 tag 键，判据是『物种 == ANIMAL_RAT』而非 IsTag。
BlockRat = true
# 方向2：拦截酒瓶（wine_bottle）堆叠。酒瓶有独立填充/容量状态，堆叠会丢失。
BlockWineBottle = true
# 方向3：拦截有耐久度的物品（过滤芯、带耐久的工具等）。判据用游戏官方 DurabilityHelper.GetMaxDurability>0，通用覆盖全部耐久物品，不靠枚举 id。
BlockDurable = true
# 方向3：拦截液体容器（水瓶/药瓶/血袋/洗发水/酒瓶等）。判据用游戏官方只读 tag LIQUID_CONTAINER_TAG，空瓶与满瓶都拦，覆盖全部液体容器。
BlockLiquidContainer = true
# 方向4：逗号分隔的容器 id，这些容器里禁止堆叠（手动配置）。留空 = 不排除任何容器。填容器 identifier（如 back_inv）后，双端判定：被叠物品所在容器 或 拖起方所在容器 命中即拦截堆叠。0.6.3 起不再自动排除交易柜台（柜台用 Alt 快移逐件上架处理）。0.6.5 起本项对【所有】合并路径生效（含 Alt 快移 / Ctrl 快移），不再只拦拖放。
StackExclude = "back_inv"
# 0.6.1：逗号分隔的物品 identifier 列表，这些物品禁止被堆叠（用于无通用 tag 的特定物品）。★ 0.6.6：默认改为空 —— 内置的默认拦截项（water_test_strip / water_tablet）已硬编码在代码里，不再写进 cfg。原因：MelonLoader 会把不含引号的逗号分隔值写成非法 TOML（`A = a,b` → 解析报错 → 整份 cfg 进入 Fallback 模式 → 所有 mod 的配置都无法保存！）。本项填写的值请【用引号包起来】，如 BlockItemIds = "foo,bar"。留空 = 不额外拦截（内置项仍生效）。
BlockItemIds = "water_test_strip,water_tablet"
# 0.6.1：按住 LeftAlt 操作物品时，把 1 个快移到交易柜台（EmporiumEntry 的库存容器）。仅在交易界面生效（柜台不存在时退化为原生行为）。总闸：关闭后本功能整体失效。与 ContainerSuite 的 LeftAlt 升级拖拽共用 Alt，已确认保留。
AltClickTransferToCounter = true
# 0.6.3 起：按住 LeftAlt 对物品『点击』（按下抬起、不移动鼠标）也能快移 —— 原版需要拖动。0.6.4 修正：本条现在是【本 mod 接管 Alt 快移】的总开关，而不是新增一个空操作键位。（旧的 0.6.3 说明写的是『原版 Alt+点击是空操作』，那是误判：原版 Alt+点击本来就会把整堆移进『落点所在窗口』的容器，见下条说明。）关闭后完全交还原生：Alt+点击/拖拽 = 整堆移入落点窗口的容器。
AltClickOnClickMode = true
# 0.6.6：开启后，只有当物品所在容器的 id 在 StackScope 白名单内才允许堆叠；StackScope 留空 = 任何容器都不堆叠。用于「除了白名单里的容器 id 以外一律不实现堆叠」。关闭（默认）：StackScope 留空 = 不限范围，堆叠照常。
StrictWhitelist = false
# 0.6.5：开启后，交易柜台容器内【任何方式】都不允许堆叠合并 —— 包括鼠标拖放、LeftAlt 快移（本 mod 的逐件上架）、LeftCtrl 快移。柜台里同名物品会各自占一格，不再并成一堆（避免柜台亏钱 / 商品被误合并）。判据用游戏自己的 EmporiumEntry 柜台容器实例（front / back / counter 三格），不靠硬编码 id，游戏改名/换场景也不会静默失效。关闭则柜台恢复可堆叠（0.6.4 及以前的行为）。
BlockCounterStack = true
# 0.6.4：按住 LeftAlt 对物品点击/拖拽时，一次转移【几个】。原生行为是整堆（内部把 -1 展开成 unitCount）。本 mod 在原生流程内把源堆预先裁剪成这个数量，因此【只移动这么多个，其余留在原容器】。1 = 逐件上架（默认，配交易柜台最常用）；设成很大的数（如 9999）= 等价原生整堆。仅在『AltClickOnClickMode』与『AltClickTransferToCounter』都开启、且本次确实是Alt 快移时生效。
AltQuickTransferAmount = 1

