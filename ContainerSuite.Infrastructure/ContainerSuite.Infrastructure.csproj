<Project Sdk="Microsoft.NET.Sdk">

	<!-- ═══════════════════════════════════════════════════════════════════
       ContainerSuite —— 2026-10-06 起合并为单 DLL。

       合并前是 4 个工程 / 4 个 DLL（ContainerSuite.Shared / CustomInfrastructure /
       SaveBagExpand / DIYUpgrade）。合并的动机不是"少 3 个文件"，而是：
         ① 消除"缺 1 个 DLL → 套件全崩"的部署故障面；
         ② 消除 4 处 AssemblyVersion 同步漂移（check-suite-version.ps1 的存在即证据）；
         ③ 用户升级只需覆盖 1 个文件，不会出现 4 个版本错配。

       本工程现在是**唯一**的编译入口：源码仍留在原 4 个目录里（文件一个都没动，
       git 历史 / 现有文件的路径引用全部保留），由下面的 <Compile Include> 拉进来编译。
       另外 3 个 csproj 已改名为 *.csproj.disabled，避免出现第二个产出。

       合并必须连带完成的 3 件事（都已在源码里做完，这里只作记录）：
         B3  4 份 AssemblyInfo.cs → 1 份（否则 CS0579）
         B1  mod.cs / DiyUpgradeMod.Core.cs 的"按程序集扫补丁" → 按命名空间过滤
             （否则同一目标被两个 Harmony ID 各装一遍，Postfix 跑两遍）
         B2  3 个 MelonPreferences 段 → 1 个 CustomInfrastructure 段
             （ModManager 归属规则只看 DLL 文件名，见 ManagerState.CategoryBelongsToMod）

        公共属性已内联在本文件（不再依赖 ..\_shared\CommonMod.props，本目录可独立编译）。
        换游戏目录：改下面 GamePath 一处，或构建时 -p:GamePath="..." 覆盖。
        ═══════════════════════════════════════════════════════════════════ -->

	<!-- ① 游戏路径与派生目录 -->
	<PropertyGroup Condition="'$(GamePath)' == ''">
		<GamePath>D:\SteamLibrary\steamapps\common\Probably Stolen Demo</GamePath>
	</PropertyGroup>
	<PropertyGroup>
		<MLNet>$(GamePath)\MelonLoader\net6</MLNet>
		<MLIl2Cpp>$(GamePath)\MelonLoader\Il2CppAssemblies</MLIl2Cpp>
	</PropertyGroup>

	<!-- ② 通用编译属性 -->
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<PlatformTarget>x64</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>
		<!-- 输出到 bin/<配置>/<Dll>.dll（不带 net6.0 子目录），部署脚本好找 -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<!-- ③ 诊断脚手架的条件编译总闸（RF 性能重构版）：
       默认**关闭** DIAG（无 CrashProbe 实现/调用、无 DIAG 探针，压每帧耗时）。
       要诊断版：
           dotnet build -c Release -p:Diag=true
       注意：无论开不开 DIAG，产物文件名都是 CustomInfrastructure.dll。 -->
	<PropertyGroup Condition="'$(Diag)' == 'true'">
		<DefineConstants>$(DefineConstants);DIAG</DefineConstants>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>CustomInfrastructure</AssemblyName>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<RootNamespace>CustomInfrastructure</RootNamespace>
	</PropertyGroup>

	<!-- ── 源码：本工程自己的 + 另外 3 个目录的（bin/obj 排除） ── -->
	<ItemGroup>
		<Compile Include="..\ContainerSuite.Shared\**\*.cs"
				 Exclude="..\ContainerSuite.Shared\bin\**;..\ContainerSuite.Shared\obj\**" />
		<Compile Include="..\ContainerSuite.SaveBag\**\*.cs"
				 Exclude="..\ContainerSuite.SaveBag\bin\**;..\ContainerSuite.SaveBag\obj\**" />
		<Compile Include="..\ContainerSuite.DIYUpgrade\**\*.cs"
				 Exclude="..\ContainerSuite.DIYUpgrade\bin\**;..\ContainerSuite.DIYUpgrade\obj\**" />
	</ItemGroup>

	<!-- ── 引用：4 个原工程的并集。全部 Private=False，绝不把依赖拷进输出目录 ── -->
	<ItemGroup>
		<Reference Include="MelonLoader">
			<HintPath>$(MLNet)\MelonLoader.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="0Harmony">
			<HintPath>$(MLNet)\0Harmony.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Il2CppInterop.Runtime">
			<HintPath>$(MLNet)\Il2CppInterop.Runtime.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Il2CppInterop.Common">
			<HintPath>$(MLNet)\Il2CppInterop.Common.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Il2CppInterop.HarmonySupport">
			<HintPath>$(MLNet)\Il2CppInterop.HarmonySupport.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Il2Cppmscorlib">
			<HintPath>$(MLIl2Cpp)\Il2Cppmscorlib.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(MLIl2Cpp)\Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(MLIl2Cpp)\UnityEngine.CoreModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- GridFx / Tooltip / 拖拽 都用到 UI -->
		<Reference Include="UnityEngine.UI">
			<HintPath>$(MLIl2Cpp)\UnityEngine.UI.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(MLIl2Cpp)\UnityEngine.UIModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- 分页 OnGUI：GUIStyle / GUI / FontStyle / TextAnchor -->
		<Reference Include="UnityEngine.IMGUIModule">
			<HintPath>$(MLIl2Cpp)\UnityEngine.IMGUIModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.TextRenderingModule">
			<HintPath>$(MLIl2Cpp)\UnityEngine.TextRenderingModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- 键盘输入：TAB 翻页 / 快捷键 -->
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(MLIl2Cpp)\UnityEngine.InputLegacyModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- DIY 的窗口音效 -->
		<Reference Include="UnityEngine.AudioModule">
			<HintPath>$(MLIl2Cpp)\UnityEngine.AudioModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<!-- ═══════════════════════════════════════════════════════════════════
       门禁检查（2026-10-13 恢复自 git 历史 e14dafb）。

       背景：_shared\check-*.ps1 门禁脚本 2026-10-12 被删除，2026-10-13 从
       git 历史恢复。原先是靠 _shared\CommonMod.props 里的 Target 挂载的，
       但本工程已把公共属性内联（见文件头「公共属性已内联」），不再 Import
       该 props。故这里直接声明两个 Exec Target，把门禁重新接入编译流程。

       两个检查都在编译本工程前跑一次（BeforeTargets=Build），任一失败即中断编译：
         · check-forbidden.ps1   —— 禁止事项静态拦截（R1~R8，含 0x80131506 相关铁律）
         · check-suite-version.ps1 —— SuiteVersion 与 AssemblyVersion 一致性

       注意：脚本是纯 ASCII（PS 5.1 按 ANSI 读），路径用 $(MSBuildThisFileDirectory)
       定位到 _shared\，与 csproj 的相对位置保持契约。
       ═══════════════════════════════════════════════════════════════════ -->
	<Target Name="CheckForbiddenPatterns" BeforeTargets="Build">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\_shared\check-forbidden.ps1&quot; -WorkspaceRoot &quot;$(MSBuildThisFileDirectory)..&quot;"
			  ContinueOnError="false"
			  IgnoreExitCode="false" />
	</Target>

	<Target Name="CheckSuiteVersionConsistency" BeforeTargets="Build">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\_shared\check-suite-version.ps1&quot; -WorkspaceRoot &quot;$(MSBuildThisFileDirectory)..&quot;"
			  ContinueOnError="false"
			  IgnoreExitCode="false" />
	</Target>

	<!-- ═══════════════════════════════════════════════════════════════════
       文档一致性门禁（2026-10-14 补齐）。

       · check-doc-keys.ps1 —— 新增。玩家文档里出现的 cfg 键名必须在 CfgKeys.cs 里
         存在。起因：2026-10-13 键名重排后，开发用户须知.md 留下了 23 个旧键名，
         照它手改 cfg 的玩家 100% 落默认值（"我改了配置没生效"的真实成因之一）。
         详见 docs/cfg-handedit-rootcause-and-fix.md

       同时废弃了 check-readme-defaults.ps1（已移到 _archive\门禁脚本-已废弃\）：
       它比对的是 v1.7.6 版 README 里那张「7A..7F 宽高默认值」表，而 README 在
       2026-10-13 已重写、不再有那张表 —— 挂回来只会立刻 `No default-size rows found`
       而挡住编译。已知缺口（值级文档漂移不再有守卫）记在 check-doc-keys.ps1 头部 TODO。
       ═══════════════════════════════════════════════════════════════════ -->
	<Target Name="CheckDocConsistency" BeforeTargets="Build">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\_shared\check-doc-keys.ps1&quot; -WorkspaceRoot &quot;$(MSBuildThisFileDirectory)..&quot;"
			  ContinueOnError="false"
			  IgnoreExitCode="false" />
	</Target>

</Project>